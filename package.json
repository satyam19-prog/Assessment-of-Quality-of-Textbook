{
  "name": "ncism-textbook-assessment",
  "version": "1.0.0",
  "description": "NCISM Textbook Quality Assessment Tool — Ministry of AYUSH, Problem Statement #242",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.ncism.textbookassessment",
    "productName": "NCISM Assessment Tool",
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "renderer.js"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education"
    },
    "dmg": {
      "title": "NCISM Assessment Tool",
      "format": "UDZO",
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  }
}